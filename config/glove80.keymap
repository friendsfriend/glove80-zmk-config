#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define HYPER LC(LS(LG(LALT)))

// layers

#define DEFAULT 0
#define LOWER 1
#define MAGIC 2
#define FACTORY_TEST 3

/*
 * Key positions based on your default_layer binding order.
 *
 * Home-row mod positions:
 *
 * A = 35
 * S = 36
 * D = 37
 * F = 38
 *
 * J = 41
 * K = 42
 * L = 43
 * ; = 44
 *
 * Same-hand home-row mod combinations are intentionally blocked.
 *
 * Examples:
 * D then F       -> df
 * F then D       -> fd
 * J then K       -> jk
 * K then L       -> kl
 *
 * Cross-hand combinations still work.
 *
 * Examples:
 * K hold + F tap -> Right Alt + F
 * D hold + K tap -> Left Alt + K
 */

#define LEFT_HAND_HRM_TRIGGER_POSITIONS \
    40 41 42 43 44 45 \
    55 56 57 58 59 60 61 62 63 \
    72 73 74 75 76 77 78 79

#define RIGHT_HAND_HRM_TRIGGER_POSITIONS \
    34 35 36 37 38 39 \
    46 47 48 49 50 51 52 53 54 \
    64 65 66 67 68 69 70 71

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT";
            #binding-cells = <2>;

            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            bindings = <&kp>, <&kp>;

            /*
             * Left-hand home-row mods A/S/D/F only become holds
             * when paired with right-hand keys.
             */
            hold-trigger-key-positions = <LEFT_HAND_HRM_TRIGGER_POSITIONS>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT";
            #binding-cells = <2>;

            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            bindings = <&kp>, <&kp>;

            /*
             * Right-hand home-row mods J/K/L/; only become holds
             * when paired with left-hand keys.
             */
            hold-trigger-key-positions = <RIGHT_HAND_HRM_TRIGGER_POSITIONS>;
        };

        // For the "layer" key, it is nice to be able to use it as either a momentary layer or a toggle.
        // First tap/hold is &mo, second tap is &to.
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mo 0>, <&to 0>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F1      &kp F2            &kp F3       &kp F4          &kp F5                                                                                              &kp F6           &kp F7           &kp F8       &kp F9                &kp F10
&kp EQUAL   &kp N1            &kp N2       &kp N3          &kp N4          &kp N5                                                                      &kp N6  &kp N7           &kp N8           &kp N9       &kp N0                &kp MINUS
&kp TAB     &kp Q             &kp W        &kp E           &kp R           &kp T                                                                       &kp Y   &kp U            &kp I            &kp O        &kp P                 &kp BSLH
&kp ESC     &hml LEFT_SHIFT A &hml LCTRL S &hml LEFT_ALT D &hml LEFT_GUI F &kp G                                                                       &kp H   &hmr RIGHT_GUI J &hmr RIGHT_ALT K &hmr RCTRL L &hmr RIGHT_SHIFT SEMI &kp SQT
&kp GRAVE   &kp Z             &kp X        &kp C           &kp V           &kp B   &kp LSHFT  &kp LCTRL  &kp LGUI  &kp LGUI  &kp RIGHT_ALT  &kp RSHFT  &kp N   &kp M            &kp COMMA        &kp DOT      &kp FSLH              &kp PG_UP
&magic 2 0  &kp HOME          &kp END      &kp LEFT        &kp RIGHT               &kp BSPC   &kp DEL    &mo 1     &mo 1     &kp RET        &kp SPACE          &kp UP           &kp DOWN         &kp LBKT     &kp RBKT              &kp PG_DN
            >;
        };

        ger_special_characters {
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREV  &kp C_NEXT  &kp C_PP                                                                  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &kp C_AL_KEYBOARD_LAYOUT
&trans                &trans                &trans      &trans      &trans    &trans                                                  &trans  &trans      &trans        &trans        &trans  &trans
&trans                &trans                &trans      &trans      &trans    &trans                                                  &trans  &kp RA(Y)   &trans        &kp RA(P)     &trans  &trans
&trans                &kp RA(Q)             &kp RA(S)   &trans      &trans    &trans                                                  &trans  &trans      &trans        &trans        &trans  &trans
&trans                &trans                &trans      &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans        &trans  &trans
&trans                &trans                &trans      &trans      &trans            &trans  &trans  &trans  &trans  &trans  &trans          &trans      &trans        &trans        &trans  &trans
            >;
        };

        magic_layer {
            bindings = <
&bt BT_CLR   &none            &none            &none            &none                                                                                     &none  &none  &none  &none  &bt BT_CLR_ALL
&none        &none            &none            &none            &none            &none                                                             &none  &none  &none  &none  &none  &none
&none        &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                   &none  &none  &none  &none  &none  &none
&bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                   &none  &none  &none  &none  &none  &bootloader
&sys_reset   &none            &none            &none            &none            &none            &bt_2  &bt_3  &none         &none  &none  &none  &none  &none  &none  &none  &none  &sys_reset
&none        &none            &none            &none            &none                             &bt_0  &bt_1  &out OUT_USB  &none  &none  &none         &none  &none  &none  &none  &to 0
            >;
        };
    };
};
